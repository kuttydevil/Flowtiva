rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: whatsapp_instances
    // Fields: tenantId, phoneNumber, customPrompt, context, status, isActive, agentType, enabled_tools, last_error, createdAt, worker_hostname, worker_pid, last_heartbeat
    //
    // Collection: whatsapp_messages
    // Fields: instanceId, contactName, sender, messageText, imageUrl, isRead, timestamp, status
    //
    // Collection: whatsapp_contacts
    // Fields: instance_id, contact_name, phone_number, last_message_text, last_message_at, unread_count, tags, crm_stage, priority, due_date
    //
    // Collection: users
    // Fields: email, plan_name, subscription_status, billing_cycle, instance_count
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.plan_name == 'admin' ||
         request.auth.token.email == "flowtiva@gmail.com");
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();
    }

    match /whatsapp_instances/{instanceId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /whatsapp_messages/{messageId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /whatsapp_contacts/{contactId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /instagram_instances/{instanceId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /workflows/{workflowId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    
    match /system_logs/{logId} {
      allow read, write: if isAdmin() || isAuthenticated();
    }
    match /activity_logs/{logId} {
      allow read, write: if isAuthenticated();
    }
    match /ai_alerts/{alertId} {
      allow read, write: if isAuthenticated();
    }
    match /ai_reports/{reportId} {
      allow read, write: if isAuthenticated();
    }
    match /ai_telemetry/{docId} {
      allow read, write: if isAuthenticated();
    }
    match /outreach_campaigns/{docId} {
      allow read, write: if isAuthenticated();
    }
    match /workflow_history/{docId} {
      allow read, write: if isAuthenticated();
    }
    match /instagram_contacts/{docId} {
      allow read, write: if isAuthenticated();
    }
    match /instagram_messages/{docId} {
      allow read, write: if isAuthenticated();
    }
    match /instagram_reposter_jobs/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /{path=**} {
      allow read, write: if false;
    }
  }
}
